{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/rag/domain-event/1.0.0",
  "title": "RAG Platform Domain Event",
  "description": "Internal event envelope. Never include document bytes, credentials, bearer tokens, or presigned URLs.",
  "oneOf": [
    { "$ref": "#/$defs/DocumentUploaded" },
    { "$ref": "#/$defs/IngestionCompleted" },
    { "$ref": "#/$defs/IngestionFailed" },
    { "$ref": "#/$defs/DocumentDeleted" }
  ],
  "$defs": {
    "Base": {
      "type": "object",
      "required": [
        "event_id",
        "event_type",
        "event_version",
        "occurred_at",
        "tenant_id",
        "correlation_id",
        "data"
      ],
      "properties": {
        "event_id": { "type": "string", "format": "uuid" },
        "event_version": { "const": 1 },
        "occurred_at": { "type": "string", "format": "date-time" },
        "tenant_id": { "type": "string", "format": "uuid" },
        "correlation_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "traceparent": { "type": "string", "maxLength": 256 }
      }
    },
    "DocumentUploaded": {
      "allOf": [
        { "$ref": "#/$defs/Base" },
        {
          "type": "object",
          "properties": {
            "event_type": { "const": "document.uploaded" },
            "data": { "$ref": "#/$defs/DocumentUploadedData" }
          },
          "required": ["event_type", "data"]
        }
      ],
      "unevaluatedProperties": false
    },
    "IngestionCompleted": {
      "allOf": [
        { "$ref": "#/$defs/Base" },
        {
          "type": "object",
          "properties": {
            "event_type": { "const": "ingestion.completed" },
            "data": { "$ref": "#/$defs/IngestionCompletedData" }
          },
          "required": ["event_type", "data"]
        }
      ],
      "unevaluatedProperties": false
    },
    "IngestionFailed": {
      "allOf": [
        { "$ref": "#/$defs/Base" },
        {
          "type": "object",
          "properties": {
            "event_type": { "const": "ingestion.failed" },
            "data": { "$ref": "#/$defs/IngestionFailedData" }
          },
          "required": ["event_type", "data"]
        }
      ],
      "unevaluatedProperties": false
    },
    "DocumentDeleted": {
      "allOf": [
        { "$ref": "#/$defs/Base" },
        {
          "type": "object",
          "properties": {
            "event_type": { "const": "document.deleted" },
            "data": { "$ref": "#/$defs/DocumentDeletedData" }
          },
          "required": ["event_type", "data"]
        }
      ],
      "unevaluatedProperties": false
    },
    "DocumentUploadedData": {
      "type": "object",
      "required": ["document_id", "version_id", "job_id", "object_key", "object_version_id", "sha256"],
      "properties": {
        "document_id": { "type": "string", "format": "uuid" },
        "version_id": { "type": "string", "format": "uuid" },
        "job_id": { "type": "string", "format": "uuid" },
        "object_key": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "object_version_id": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "IngestionCompletedData": {
      "type": "object",
      "required": ["document_id", "version_id", "job_id", "chunk_count", "embedding_model_version", "index_version"],
      "properties": {
        "document_id": { "type": "string", "format": "uuid" },
        "version_id": { "type": "string", "format": "uuid" },
        "job_id": { "type": "string", "format": "uuid" },
        "chunk_count": { "type": "integer", "minimum": 0 },
        "embedding_model_version": { "type": "string", "maxLength": 128 },
        "index_version": { "type": "string", "maxLength": 128 }
      },
      "additionalProperties": false
    },
    "FailureSummary": {
      "type": "object",
      "required": ["code", "retryable"],
      "properties": {
        "code": { "type": "string", "maxLength": 64 },
        "message": { "type": "string", "maxLength": 500 },
        "retryable": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "IngestionFailedData": {
      "type": "object",
      "required": ["document_id", "version_id", "job_id", "failure"],
      "properties": {
        "document_id": { "type": "string", "format": "uuid" },
        "version_id": { "type": "string", "format": "uuid" },
        "job_id": { "type": "string", "format": "uuid" },
        "failure": { "$ref": "#/$defs/FailureSummary" }
      },
      "additionalProperties": false
    },
    "DocumentDeletedData": {
      "type": "object",
      "required": ["document_id", "version_ids", "deletion_operation_id"],
      "properties": {
        "document_id": { "type": "string", "format": "uuid" },
        "version_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "format": "uuid" }
        },
        "deletion_operation_id": { "type": "string", "format": "uuid" }
      },
      "additionalProperties": false
    }
  }
}
